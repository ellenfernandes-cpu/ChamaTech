# Copie para .env (cp .env.example .env) e ajuste os valores.
# O arquivo .env NUNCA deve ser commitado.

APP_ENV=dev

POSTGRES_DB=chamatech
POSTGRES_USER=chamatech
POSTGRES_PASSWORD=troque-esta-senha

# URL que a API usa para falar com o banco ("db" é o nome do serviço no compose)
DATABASE_URL=postgresql://chamatech:troque-esta-senha@db:5432/chamatech

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
